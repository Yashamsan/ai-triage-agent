# Copy this file to .env and fill in your API key
# DeepSeek (recommended — cheapest, ~$0.14/1M tokens): platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Only needed for call sites explicitly using an openrouter/ model — most of
# the app defaults to DeepSeek directly. Get a key at openrouter.ai.
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Or use Claude Haiku — uncomment and add key
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Override the default model per language (both default to
# deepseek/deepseek-chat direct, or a LiteLLM proxy model if
# LITELLM_PROXY_URL is set)
# LLM_MODEL=deepseek/deepseek-chat      # English agent
# AR_LLM_MODEL=deepseek/deepseek-chat   # Arabic agent

# Langfuse observability — sign up at cloud.langfuse.com, or self-host
# (see README's "Self-hosted LangFuse" section)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# PostgreSQL + pgvector — required for all DB-backed tools (RAG, ProofLayer,
# precedent memory). Docker Compose overrides this to point at the
# triage-db container; only needed here for the manual (non-Docker) setup.
# Run: sudo service postgresql start && python -m app.seed_data
DATABASE_URL=postgresql://postgres:postgres@localhost/triage_agent

# Force the embedding model (BAAI/bge-m3) onto "cpu" or "cuda" — auto-detects
# if unset. See README's "Embeddings & RAG" section before enabling GPU on a
# memory-constrained host.
# EMBEDDING_DEVICE=cpu

# LiteLLM Proxy — uncomment when running proxy/config.yaml locally
# LITELLM_PROXY_URL=http://localhost:4000
# LITELLM_MASTER_KEY=your_proxy_master_key_here

# Zero Trust security — guard classifier model, defaults to LLM_MODEL if unset
# Set to a cheaper model to reduce guard call cost
# GUARD_MODEL=deepseek/deepseek-chat
